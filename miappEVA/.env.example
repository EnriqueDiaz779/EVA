DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-this-secret-key
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Usa una sola URL de conexion si Railway te la da.
DATABASE_URL=mysql://USER:PASSWORD@HOST:PORT/DBNAME

# O usa variables individuales.
DB_NAME=eva_db
DB_USER=eva_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_SSL_REQUIRED=False

OPENAI_API_KEY=
MAPBOX_TOKEN_PUBLIC=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
EVA_ENABLE_SCHEDULER=False
